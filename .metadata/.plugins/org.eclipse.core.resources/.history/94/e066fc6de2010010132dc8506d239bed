package teste.recursos;
//CONTROLADOR REST

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import teste.entidade.ItemOrdemDePedido;

@RestController
@RequestMapping(value = "/itensPedidos")
public class RecursoItemOrdemDePedido {
	
	@Autowired
	private ServicoItemOrdemDepedido servicoAux;

//responseEntity vai receber a classe categoria
	@GetMapping
	public ResponseEntity<List<ItemOrdemDepedido>> findAll(){
		List<ItemOrdemDePedido> listServicoEncontrado = servicoAux.findAll(); 
		return ResponseEntity.ok().body(listServicoEncontrado); 
	}
	@GetMapping(value = "/{id}") // esse comando indica que vou aceitar um ID na requisicao da minha URL
	public ResponseEntity<ItemOrdemDePedido> findById(@PathVariable Long id){
		ItemOrdemDePedido wObjeto = servicoAux.findById(id);
		return ResponseEntity.ok().body(wObjeto);
	}
}